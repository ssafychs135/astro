---
import MainLayout from '../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
	{ href: `${base}/`, label: '메인', note: '소개와 대표 프로젝트' },
	{ href: `${base}/portfolio/`, label: '01_Portfolio', note: '프로젝트 목록' },
	{ href: `${base}/blog/`, label: '02_Research', note: '기술 글 목록' },
	{ href: `${base}/about/`, label: '03_Identity', note: '이력과 역량' },
];
---

<MainLayout title="404" description="요청한 페이지를 찾을 수 없습니다." noindex>
	<header class="mb-16">
		<div class="tech-label mb-6">> Error_404 // Not_Found</div>
		<h1 class="text-6xl md:text-8xl font-black tracking-tighter pb-8">404</h1>
		<p class="text-xl text-text-muted max-w-2xl leading-relaxed">
			요청한 페이지를 찾을 수 없습니다. 페이지 주소가 바뀌었거나 글이 삭제되었을 수 있습니다.
		</p>
	</header>

	<ul class="list-none p-0 m-0 grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl">
		{links.map((l) => (
			<li>
				<a href={l.href} class="flex items-baseline justify-between gap-4 bg-surface-low border border-surface-highest/30 rounded-sm px-6 py-5 no-underline hover:border-primary transition-colors group">
					<span class="tech-font text-sm font-black tracking-widest group-hover:text-primary transition-colors">{l.label}</span>
					<span class="text-sm text-text-muted">{l.note}</span>
				</a>
			</li>
		))}
	</ul>
</MainLayout>
