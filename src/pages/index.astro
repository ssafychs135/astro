---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { byPubDateDesc } from '../utils/sortPosts';
import { groupBySeries } from '../utils/series';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION } from '../consts';
import profileImg from '../assets/profile.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 1. 포트폴리오: 메인에는 요약만 두고 본문은 상세 페이지에서 본다.
const projects = (await getCollection('portfolio')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 2. 최근 글: 연재는 한 줄로 묶어 첫 편으로 연결한다.
const recent = groupBySeries((await getCollection('blog')).sort(byPubDateDesc))
	.slice(0, 3)
	.map((entry) => {
		if (entry.kind === 'series') {
			const first = entry.posts[0];
			const latest = entry.posts.reduce((d, p) => (p.data.pubDate > d ? p.data.pubDate : d), first.data.pubDate);
			return {
				href: `${base}/blog/${first.id}/`,
				date: latest,
				title: entry.name,
				summary: first.data.description,
				label: `연재 · ${entry.posts.length}편`,
			};
		}
		const { post } = entry;
		return {
			href: `${base}/blog/${post.id}/`,
			date: post.data.pubDate,
			title: post.data.title,
			summary: post.data.description,
			label: post.data.tags?.[0] ?? 'Note',
		};
	});
---

<MainLayout description={SITE_DESCRIPTION}>
	<div class="hero-grid grid grid-cols-1 lg:grid-cols-12 gap-12 relative">
		<!-- Main Narrative Area (Left/Center) -->
		<div class="col-span-12 lg:col-span-9 min-w-0 space-y-32">

			<!-- SECTION 01: INTRO -->
			<section id="intro" class="min-h-[60vh] flex flex-col justify-center">
				<div class="flex flex-col md:flex-row gap-12 items-start md:items-center">
					<!-- Profile Image -->
					<div class="relative group shrink-0">
						<div class="absolute -inset-1 bg-gradient-to-tr from-primary to-secondary rounded-sm blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
						<div class="relative w-40 h-40 md:w-52 md:h-52 bg-surface-low rounded-sm overflow-hidden border border-white/5">
							<Image src={profileImg} alt="최형선 프로필" width={600} loading="eager" fetchpriority="high" class="w-full h-full object-cover object-top" />
						</div>
					</div>

					<div class="space-y-7 w-full min-w-0">
						<div class="tech-label text-lg font-bold">
							<div class="pulse-dot scale-150"></div>
							AI-Native Developer
						</div>
						<h1 class="text-4xl md:text-5xl xl:text-6xl font-black tracking-tight leading-[1.2] pb-7">
							언어·음성 모델을 적용하고<br/><span class="text-primary">측정으로 설정을 고릅니다</span>
						</h1>
						<p class="text-lg md:text-xl text-text-muted leading-relaxed max-w-3xl">
							팀 프로젝트에서는 와인 추천 서비스의 LLM과 AR 안경 피팅의 촬영·얼굴 추적 로직을 맡았습니다. 개인 프로젝트로는 RAG 챗봇과 챕터 생성 파이프라인을 만들고, 소형 LLM 파인튜닝을 진행했습니다.
						</p>
						<p class="text-xl md:text-2xl text-text-muted">
							<span class="text-text-base font-bold underline decoration-primary decoration-4 underline-offset-8">AI 네이티브 개발자 최형선</span>입니다.
						</p>
						<div class="tech-font text-xs font-bold tracking-widest text-secondary">SSAFY 14기 수료 · SSAFY 프로젝트 우수상 3회</div>
						<div class="flex flex-wrap gap-4 pt-2">
							<a href="#work" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-bg-base font-black tech-font text-sm rounded-sm no-underline hover:bg-secondary transition-colors">
								프로젝트 보기 <span aria-hidden="true">→</span>
							</a>
							<a href={`${base}/about/`} class="inline-flex items-center gap-2 px-6 py-3 border border-surface-highest font-black tech-font text-sm rounded-sm no-underline hover:border-primary hover:text-primary transition-colors">
								이력과 역량 보기 <span aria-hidden="true">→</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- SECTION 02: SELECTED WORK (SUMMARY → detail page) -->
			<section id="work" class="space-y-14">
				<div class="border-b border-surface-highest/20 pb-8">
					<span class="tech-label text-secondary text-xl mb-4 font-bold">> Track_A // Projects</span>
					<h2 class="text-5xl md:text-7xl font-black uppercase tracking-tighter">Selected Work</h2>
				</div>

				<div class="space-y-12">
					{projects.map((project, i) => {
						const href = `${base}/portfolio/${project.id}/`;
						return (
							<article class="project-summary group border-l-4 border-primary pl-8 py-1">
								<div class="flex items-center justify-between gap-4 mb-3">
									<div class="tech-label text-xs opacity-50 font-black">Record_{String(i + 1).padStart(2, '0')}</div>
									{project.data.period && (
										<div class="tech-font text-xs font-bold text-secondary tracking-widest">{project.data.period}</div>
									)}
								</div>
								<h3 class="text-2xl md:text-3xl font-black tracking-tight leading-tight m-0">
									<a href={href} class="no-underline hover:text-primary transition-colors">{project.data.title}</a>
								</h3>
								{project.data.role && (
									<div class="tech-font text-xs text-text-muted mt-3 font-bold tracking-widest">{project.data.role}</div>
								)}
								<p class="text-base md:text-lg text-text-muted leading-relaxed max-w-4xl mt-4 mb-0">
									{project.data.description}
								</p>
								<div class="flex flex-wrap gap-2 mt-5">
									{project.data.stack.slice(0, 8).map((s) => <span class="px-3 py-1.5 bg-surface-highest text-[11px] font-bold tech-font text-secondary rounded-sm tracking-widest">{s}</span>)}
								</div>
								<a href={href} class="inline-flex items-center gap-2 tech-font text-sm text-primary font-black mt-6 no-underline group-hover:gap-4 transition-all">
									상세 보기 <span aria-hidden="true">→</span>
								</a>
							</article>
						);
					})}
				</div>
				<a href={`${base}/portfolio/`} class="inline-flex items-center gap-2 tech-font text-sm font-black opacity-60 hover:opacity-100 hover:text-primary transition-all no-underline">
					전체 프로젝트 목록 <span aria-hidden="true">→</span>
				</a>
			</section>

			<!-- SECTION 03: LATEST RESEARCH -->
			<section id="logs" class="pb-16">
				<div class="flex justify-between items-end gap-6 mb-14 border-b border-white/5 pb-10">
					<div>
						<span class="tech-label text-primary text-xl mb-4 font-black">> Track_B // Learning_Loop</span>
						<h2 class="text-5xl md:text-6xl font-bold uppercase tracking-tighter">Recent Research</h2>
					</div>
					<a href={`${base}/blog/`} class="tech-font text-sm opacity-60 hover:opacity-100 hover:text-primary transition-all font-black no-underline whitespace-nowrap">전체 글 보기 <span aria-hidden="true">→</span></a>
				</div>
				<div class="bg-black/50 backdrop-blur-md rounded-sm border border-surface-highest/30 overflow-hidden">
					{recent.map((r) => (
						<a href={r.href} class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6 px-5 md:px-10 py-6 md:py-8 border-b border-white/5 hover:bg-primary/5 transition-colors group no-underline">
							<div class="md:col-span-2 tech-font text-sm text-text-muted mt-1 font-bold">
								<FormattedDate date={r.date} />
							</div>
							<div class="md:col-span-8 min-w-0">
								<div class="font-bold text-xl md:text-2xl group-hover:text-primary transition-colors tracking-tight">{r.title}</div>
								<p class="text-sm text-text-muted mt-2 mb-0 line-clamp-1">{r.summary}</p>
							</div>
							<div class="md:col-span-2 md:text-right tech-font text-xs text-secondary mt-1 font-black tracking-widest">
								{r.label}
							</div>
						</a>
					))}
				</div>
			</section>
		</div>

		<!-- Sticky Sidebar Widget (Right) -->
		<aside class="hidden lg:block lg:col-span-3">
			<div class="sticky top-28 space-y-16">
				<div class="glass-panel p-12 rounded-sm border-l-4 border-primary">
					<div class="tech-label text-sm mb-10 opacity-50 font-black">Connect</div>
					<div class="space-y-6">
						<a href="https://github.com/ssafychs135" class="flex items-center gap-5 group/c">
							<div class="w-3 h-3 bg-primary rounded-full shadow-[0_0_15px_var(--primary)]"></div>
							<span class="text-sm tech-font font-black tracking-[0.2em] group-hover/c:text-primary transition-colors">GitHub</span>
						</a>
						<a href="mailto:ssafychs135@gmail.com" class="flex items-center gap-5 group/c">
							<div class="w-3 h-3 bg-secondary rounded-full shadow-[0_0_15px_var(--secondary)]"></div>
							<span class="text-sm tech-font font-black tracking-[0.2em] group-hover/c:text-secondary transition-colors">Email</span>
						</a>
					</div>
				</div>

				<nav class="p-12 border-l-2 border-white/10 space-y-8" aria-label="페이지 안 이동">
					<div class="tech-label text-xs mb-8 opacity-30 font-black">Navigation_Index</div>
					<a href="#intro" class="block text-sm tech-font font-black opacity-50 hover:opacity-100 hover:text-primary transition-all transform hover:translate-x-3 tracking-widest">01_Intro</a>
					<a href="#work" class="block text-sm tech-font font-black opacity-50 hover:opacity-100 hover:text-primary transition-all transform hover:translate-x-3 tracking-widest">02_Selected_Work</a>
					<a href="#logs" class="block text-sm tech-font font-black opacity-50 hover:opacity-100 hover:text-primary transition-all transform hover:translate-x-3 tracking-widest">03_Recent_Research</a>
					<a href={`${base}/about/`} class="block text-sm tech-font font-black opacity-50 hover:opacity-100 hover:text-primary transition-all transform hover:translate-x-3 tracking-widest">04_Identity →</a>
				</nav>
			</div>
		</aside>
	</div>
</MainLayout>
