---
interface Card {
	key: string;
	title: string;
	sub?: string;
}
interface Props {
	eyebrow?: string;
	heading: string;
	cards: Card[];
}
const { eyebrow = '⚙ 인터랙티브 · 선택', heading, cards } = Astro.props;
---

<div class="ts-ix not-prose" data-ts-group>
	<div class="ts-eyebrow">{eyebrow}</div>
	<h4 class="ts-h">{heading}</h4>
	<div class="ts-cards">
		{cards.map((c, i) => (
			<button class:list={['ts-card', { on: i === 0 }]} data-ts-tab={c.key}>
				<div class="t">{c.title}</div>
				{c.sub && <div class="s">{c.sub}</div>}
			</button>
		))}
	</div>
	<div class="ts-result">
		{cards.map((c, i) => (
			<div class:list={['ts-panel', { show: i === 0 }]} data-ts-panel data-key={c.key}>
				{i === 0 && <slot name="s0" />}
				{i === 1 && <slot name="s1" />}
				{i === 2 && <slot name="s2" />}
				{i === 3 && <slot name="s3" />}
				{i === 4 && <slot name="s4" />}
			</div>
		))}
	</div>
</div>

<script>import './runtime.ts';</script>
