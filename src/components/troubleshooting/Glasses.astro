---
interface Props {
	lens?: boolean;
}
const { lens = false } = Astro.props;
---

<div class="ts-svgwrap not-prose">
	<svg width="200" height="120" viewBox="0 0 180 120" role="img" aria-label={lens ? '렌즈가 채워진 안경' : '렌즈 없는 안경테'}>
		<rect x="16" y="40" width="60" height="40" rx="16" fill="none" stroke="var(--text-base)" stroke-width="3"></rect>
		<rect x="104" y="40" width="60" height="40" rx="16" fill="none" stroke="var(--text-base)" stroke-width="3"></rect>
		<path d="M76 56 Q90 48 104 56" fill="none" stroke="var(--text-base)" stroke-width="3"></path>
		<line x1="16" y1="50" x2="4" y2="44" stroke="var(--text-base)" stroke-width="3"></line>
		<line x1="164" y1="50" x2="176" y2="44" stroke="var(--text-base)" stroke-width="3"></line>
		{lens && (
			<>
				<ellipse cx="46" cy="60" rx="29" ry="19" fill="color-mix(in srgb, var(--color-primary) 22%, transparent)" stroke="var(--color-primary)"></ellipse>
				<ellipse cx="134" cy="60" rx="29" ry="19" fill="color-mix(in srgb, var(--color-primary) 22%, transparent)" stroke="var(--color-primary)"></ellipse>
			</>
		)}
	</svg>
</div>
