---
// Series part 2: where the leftover game came from, diagnosed one axis at a time.
//
// Six bars in three axis groups, each the share of game left at the point that keeps 90.5% of
// just-chatting, on 23 held-out broadcasts, counted per window. The dashed line is the classifier
// then in operation (2.1%). Only the learning-target axis crosses to its left. This is the diagnosis
// made with the classifier of that time, per window and before spans were joined, so it is not set
// beside the replacement result in part 2's table.
// Source: CHZZK docs/blog/handoff/04-블로그-연재-재료.md 「2편 · 병목 진단」 (screen-mode-classifier.md
// L3318-3333).
import '../chzzk/cz.css';
import './cb.css';

type Bar = { k: string; v: number; ok?: boolean; base?: boolean };
const GROUPS: { axis: string; bars: Bar[] }[] = [
	{ axis: '판정 기준', bars: [{ k: '모든 방송에 같은 기준', v: 2.1, base: true }, { k: '방송마다 다른 기준', v: 4.5 }] },
	{ axis: '헤드', bars: [{ k: 'MLP (256)', v: 7.9 }, { k: '부스팅', v: 3.3 }] },
	{ axis: '학습 자료', bars: [{ k: '채점 방송의 절반', v: 0.8, ok: true }, { k: '채점용의 다른 방송', v: 1.6, ok: true }] },
];
const MAX = 8.5;
const BASE = 2.1;
---

<figure class="cz cb-fig not-prose ba" data-cb-bottleneck>
	<div class="cb-head">
		<p class="cb-title">고칠 곳별 남은 게임 · 저스트채팅 90.5% 기준</p>
		<button class="cz-replay" data-cz-replay>▶ 다시 보기</button>
	</div>
	<div class="ba-body" role="img"
		aria-label="학습에 쓰지 않은 23편에서 판정 기준을 저스트채팅이 90.5% 남도록 맞췄을 때, 게임 창 가운데 걸러지지 않고 남은 비율. 판정 기준을 모든 방송에 같게 두면 2.1%, 방송마다 다르게 두면 4.5%. 헤드를 MLP로 바꾸면 7.9%, 부스팅으로 바꾸면 3.3%. 학습 자료를 채점하는 방송의 절반으로 바꾸면 0.8%, 채점용 방송 가운데 다른 방송으로 바꾸면 1.6%. 당시 운영 분류기의 값은 2.1%다.">
		<div class="ba-line" style={`left:calc(11rem + (100% - 11rem) * ${BASE / MAX})`} data-line><span>당시 운영 분류기 2.1%</span></div>
		{GROUPS.map((g) => (
			<div class="ba-group" data-group>
				<p class="ba-axis">{g.axis}</p>
				{g.bars.map((b) => (
					<div class="ba-row">
						<p class="ba-k">{b.k}</p>
						<div class="ba-track">
							<span class:list={['ba-fill', b.ok ? 'ok' : b.base ? 'base' : 'bad']} data-w={(b.v / MAX) * 100} style={`width:${(b.v / MAX) * 100}%`}></span>
							<b data-late style={`left:calc(${(b.v / MAX) * 100}% + 0.4rem)`}>{b.v}%</b>
						</div>
					</div>
				))}
			</div>
		))}
	</div>
</figure>

<style>
	.ba-body { position: relative; display: flex; flex-direction: column; gap: 0.9rem; padding-top: 1.4rem; }
	.ba-line { position: absolute; top: 0; bottom: 0; width: 0; border-left: 1.5px dashed var(--cz-muted); }
	.ba-line span { position: absolute; top: -0.1rem; left: 0.4rem; white-space: nowrap; font-size: 0.7rem; color: var(--cz-muted); }
	.ba-group { display: flex; flex-direction: column; gap: 0.35rem; }
	.cb-fig .ba-axis { margin: 0; font-size: 0.74rem; font-weight: 800; color: var(--cz-accent); }
	.ba-row { display: grid; grid-template-columns: 11rem 1fr; align-items: center; }
	.cb-fig .ba-k { margin: 0; font-size: 0.82rem; color: var(--cz-text); }
	.ba-track { position: relative; height: 20px; }
	.ba-fill { position: absolute; inset: 0 auto 0 0; border-radius: 5px; }
	.ba-fill.ok { background: var(--cz-ok); }
	.ba-fill.bad { background: color-mix(in srgb, var(--cz-bad) 65%, transparent); }
	.ba-fill.base { background: var(--cz-muted); opacity: 0.7; }
	.ba-track b { position: absolute; top: 50%; transform: translateY(-50%); font: 800 0.8rem/1 var(--font-space-grotesk); color: var(--cz-text); }
</style>

<script>
	import { createTimeline, type Timeline } from 'animejs';
	import { mount } from '../chzzk/cz-runtime';

	mount('[data-cb-bottleneck]', (root) => {
		const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
		const line = root.querySelector<HTMLElement>('[data-line]')!;
		let tl: Timeline | null = null;
		const fills = () => [...root.querySelectorAll<HTMLElement>('.ba-fill')];
		const labels = () => [...root.querySelectorAll<HTMLElement>('[data-late]')];
		const arm = () => { tl?.pause(); fills().forEach((f) => (f.style.width = '0%')); labels().forEach((l) => (l.style.opacity = '0')); line.style.opacity = '0'; };
		const finish = () => { tl?.pause(); fills().forEach((f) => (f.style.width = `${f.dataset.w}%`)); labels().forEach((l) => (l.style.opacity = '1')); line.style.opacity = '1'; };
		const play = () => {
			arm();
			const T = createTimeline({ autoplay: false, defaults: { ease: 'outCubic' } });
			T.add(line, { opacity: [0, 1], duration: 400 }, 100);
			// One axis at a time: only the last group crosses to the left of the dashed line.
			groups.forEach((g, i) => {
				const at = 450 + i * 750;
				g.querySelectorAll<HTMLElement>('.ba-fill').forEach((f, j) => T.add(f, { width: ['0%', `${f.dataset.w}%`], duration: 650 }, at + j * 120));
				g.querySelectorAll<HTMLElement>('[data-late]').forEach((l, j) => T.add(l, { opacity: [0, 1], duration: 250 }, at + 500 + j * 120));
			});
			tl = T;
			T.play();
		};
		return { arm, play, finish };
	});
</script>
