---
// Series part 7: why 28,672 failed and 20,480 passed with both models on one 16GB card.
//
// Top: the 26B server's memory against context length. Five measured points lie on a line of 18.3KB
// per token; the two settings tried (20,480 and 28,672) are read off that line (hollow points), not
// measured. The card line is 16,311MB, worked back from the 40,960 run (used 15,490 + free 821).
// Bottom: the two settings stacked: 26B (line value) + first inference 112MB (measured at 40,960, 26B
// alone, carried over) + embedding server 486MB (the -ub 1024 profile) + reserved 465MB. 28,672 ends
// 19MB past the card line; 20,480 stays 131MB under it. Both axes are zoomed and their ticks say MB.
// Source: CHZZK docs/blog/handoff/04-블로그-연재-재료.md 「7편」 and correction 6 (speed-levers.md
// L5-13, L27-36, L53-54, L73-77, L606).
import '../chzzk/cz.css';
import './cb.css';

const CARD = 16311;
// Top chart.
const W = 900, H = 236, L = 64, R = 132, T = 20, B = 40;
const X0 = 16384, X1 = 48128, Y0 = 14900, Y1 = 16400;
const lx = (c: number) => L + ((c - X0) / (X1 - X0)) * (W - L - R);
const ly = (v: number) => T + ((Y1 - v) / (Y1 - Y0)) * (H - T - B);
const MEASURED = [[16384, 15042], [24576, 15192], [32768, 15340], [40960, 15490], [48128, 15624]];
const READ = [[20480, 15117], [28672, 15267]];
const line = MEASURED.map(([c, v], i) => `${i ? 'L' : 'M'}${lx(c).toFixed(1)},${ly(v).toFixed(1)}`).join(' ');
const fmt = (n: number) => n.toLocaleString('en-US');
// Legend sits top-left, between the card line and the top gridline.
const LEG_Y = (ly(CARD) + ly(16000)) / 2 + 2;
// Bottom bars.
const A0 = 14500, A1 = 16500;
const ap = (v: number) => ((v - A0) / (A1 - A0)) * 100;
const PARTS = [
	{ k: 'first', label: '첫 추론', v: 112, note: '40,960 단독에서 잰 값' },
	{ k: 'embed', label: '임베딩 서버', v: 486 },
	{ k: 'reserved', label: '예약', v: 465 },
];
const ROWS = [
	{ ctx: 28672, base: 15267 },
	{ ctx: 20480, base: 15117 },
].map((r) => {
	const total = r.base + PARTS.reduce((s, p) => s + p.v, 0);
	return { ...r, total, fits: total <= CARD };
});
---

<figure class="cz cb-fig not-prose vb" data-cb-vram>
	<div class="cb-head">
		<p class="cb-title">문맥 길이와 VRAM · 26B와 임베딩 서버를 한 카드에</p>
		<button class="cz-replay" data-cz-replay>▶ 다시 보기</button>
	</div>

	<p class="vb-sub">26B 서버 사용량 · 문맥 길이별</p>
	<svg viewBox={`0 0 ${W} ${H}`} role="img"
		aria-label="26B 서버의 VRAM 사용량은 문맥 길이 16,384에서 15,042MB, 24,576에서 15,192MB, 32,768에서 15,340MB, 40,960에서 15,490MB, 48,128에서 15,624MB로, 토큰당 18.3KB씩 늘어나는 직선 위에 있다. 이 직선에서 읽으면 20,480은 15,117MB, 28,672는 15,267MB다. 카드 총량은 40,960 실측의 사용량과 여유를 더한 16,311MB다.">
		{[15000, 15500, 16000].map((v) => (
			<g class="vb-grid" data-grid>
				<line x1={L} x2={W - R} y1={ly(v)} y2={ly(v)} />
				<text x={L - 8} y={ly(v) + 4} class="vb-tick vb-tick-y">{fmt(v)}</text>
			</g>
		))}
		{[...MEASURED, ...READ].map(([c]) => (
			<text x={lx(c)} y={H - B + 18} class:list={['vb-tick vb-tick-x', { read: READ.some(([r]) => r === c) }]} data-grid>{fmt(c)}</text>
		))}
		<text x={(L + W - R) / 2} y={H - 4} class="vb-axis" data-grid>문맥 길이 (토큰)</text>
		<text x={L - 8} y={T - 6} class="vb-axis vb-axis-y" data-grid>MB</text>

		<g data-card>
			<line x1={L} x2={W - R} y1={ly(CARD)} y2={ly(CARD)} class="vb-card" />
			<text x={W - R + 8} y={ly(CARD) + 4} class="vb-card-t">카드 16,311</text>
			<text x={W - R + 8} y={ly(CARD) + 18} class="vb-card-s">40,960 실측에서 역산</text>
		</g>

		<path d={line} class="vb-line" data-draw />
		<text x={(lx(MEASURED[2][0]) + lx(MEASURED[3][0])) / 2} y={(ly(MEASURED[2][1]) + ly(MEASURED[3][1])) / 2 - 12} class="vb-slope" data-pt>토큰당 18.3KB</text>
		{MEASURED.map(([c, v]) => <circle cx={lx(c)} cy={ly(v)} r="4.5" class="vb-pt" data-pt />)}
		{READ.map(([c, v]) => (
			<g data-read>
				<line x1={lx(c)} x2={lx(c)} y1={ly(v) + 6} y2={H - B} class="vb-drop" />
				<circle cx={lx(c)} cy={ly(v)} r="5" class="vb-pt read" />
				<text x={lx(c)} y={ly(v) - 10} class="vb-read-t">{fmt(v)}</text>
			</g>
		))}
		<g class="vb-legend" data-grid>
			<circle cx={L + 14} cy={LEG_Y} r="4.5" class="vb-pt" /><text x={L + 24} y={LEG_Y + 4}>실측</text>
			<circle cx={L + 74} cy={LEG_Y} r="5" class="vb-pt read" /><text x={L + 84} y={LEG_Y + 4}>직선 위 값 (아래 두 설정)</text>
		</g>
	</svg>

	<p class="vb-sub">임베딩 서버를 옆에 올리고 첫 추론까지 · 설정별 합계</p>
	<div class="vb-bars" role="img"
		aria-label="문맥 28,672: 26B 15,267MB, 첫 추론 112MB(40,960 단독에서 잰 값을 옮겨 씀), 임베딩 서버 486MB, 예약 465MB를 더하면 16,330MB로 카드 16,311MB를 넘는다. 문맥 20,480: 15,117MB에 같은 세 몫을 더하면 16,180MB로 카드보다 131MB 적다.">
		<div class="vb-row vb-row-axis">
			<span></span>
			<div class="vb-scale" data-grid>
				{[14500, 15000, 15500, 16000, 16500].map((v) => <span style={`left:${ap(v)}%`}>{fmt(v)}</span>)}
				<b style={`left:${ap(CARD)}%`}>카드 16,311</b>
			</div>
			<span></span>
		</div>
		{ROWS.map((r) => (
			<div class="vb-row" data-row>
				<p class="vb-k">문맥 {fmt(r.ctx)}</p>
				<div class="vb-track">
					<i class="vb-cardline" style={`left:${ap(CARD)}%`}></i>
					<div class="vb-stack">
						<span class="vb-seg base" data-w={ap(r.base)} style={`width:${ap(r.base)}%`}><em>26B {fmt(r.base)}</em></span>
						{PARTS.map((p) => <span class:list={['vb-seg', p.k]} data-w={(p.v / (A1 - A0)) * 100} style={`width:${(p.v / (A1 - A0)) * 100}%`}></span>)}
					</div>
				</div>
				<p class:list={['vb-total', { fits: r.fits }]} data-late>
					<b>{fmt(r.total)}MB</b>
					<span>{r.fits ? `${fmt(CARD - r.total)}MB 남음` : '첫 추론에서 서버가 죽음'}</span>
				</p>
			</div>
		))}
		<div class="vb-keys" data-grid>
			<span><i class="vb-key base"></i>26B (직선 위 값)</span>
			{PARTS.map((p) => <span><i class:list={['vb-key', p.k]}></i>{p.label} +{p.v}{'note' in p && ` (${p.note})`}</span>)}
		</div>
	</div>
</figure>

<style>
	.vb text { font-family: var(--font-pretendard); }
	.cb-fig .vb-sub { margin: 0.2rem 0 0.4rem; font-size: 0.76rem; font-weight: 700; color: var(--cz-muted); }
	.vb-grid line { stroke: var(--cz-line); }
	.vb-tick { font-size: 11px; fill: var(--cz-muted); font-family: var(--font-space-grotesk); }
	.vb-tick-y { text-anchor: end; }
	.vb-tick-x { text-anchor: middle; }
	.vb-tick-x.read { fill: var(--cz-accent-2); font-weight: 700; }
	.vb-axis { font-size: 11.5px; fill: var(--cz-muted); text-anchor: middle; }
	.vb-axis-y { text-anchor: end; font-family: var(--font-space-grotesk); }
	.vb-card { stroke: var(--cz-bad); stroke-width: 1.5; stroke-dasharray: 6 4; }
	.vb-card-t { font: 800 12px var(--font-space-grotesk); fill: var(--cz-bad); }
	.vb-card-s { font-size: 10.5px; fill: var(--cz-muted); }
	.vb-line { fill: none; stroke: var(--cz-accent-2); stroke-width: 2.2; }
	.vb-slope { font-size: 11.5px; fill: var(--cz-accent-2); text-anchor: middle; }
	.vb-pt { fill: var(--cz-accent-2); }
	.vb-pt.read { fill: var(--color-surface-low); stroke: var(--cz-accent-2); stroke-width: 2; }
	.vb-drop { stroke: var(--cz-accent-2); stroke-dasharray: 2 3; opacity: 0.6; }
	.vb-read-t { font: 700 11px var(--font-space-grotesk); fill: var(--cz-accent-2); text-anchor: middle; }
	.vb-legend text { font-size: 11px; fill: var(--cz-text); }

	.vb-bars { display: flex; flex-direction: column; gap: 0.55rem; }
	.vb-row { display: grid; grid-template-columns: 6.5rem 1fr 10.5rem; align-items: center; gap: 0.8rem; }
	.vb-scale { position: relative; height: 1.1rem; }
	.vb-scale span, .vb-scale b { position: absolute; transform: translateX(-50%); white-space: nowrap; font: 500 0.68rem/1 var(--font-space-grotesk); color: var(--cz-muted); }
	.vb-scale span:first-child { transform: none; }
	.vb-scale span:nth-child(5) { transform: translateX(-100%); }
	.vb-scale b { top: -0.05rem; font-weight: 800; color: var(--cz-bad); transform: translateX(-100%); padding-right: 0.3rem; }
	.cb-fig .vb-k { margin: 0; font-size: 0.8rem; font-weight: 700; color: var(--cz-text); }
	.vb-track { position: relative; height: 30px; }
	.vb-cardline { position: absolute; top: -6px; bottom: -6px; width: 0; border-left: 1.5px dashed var(--cz-bad); z-index: 1; }
	.vb-stack { position: absolute; inset: 0; display: flex; }
	.vb-seg { position: relative; height: 100%; overflow: hidden; }
	.vb-seg.base { background: color-mix(in srgb, var(--cz-accent-2) 55%, transparent); border-radius: 5px 0 0 5px; }
	.vb-seg.base em { position: absolute; left: 0.55rem; top: 50%; transform: translateY(-50%); font: 700 0.74rem/1 var(--font-space-grotesk); font-style: normal; color: var(--cz-text); white-space: nowrap; }
	.vb-seg.first { background: color-mix(in srgb, var(--cz-accent-2) 28%, transparent); }
	.vb-seg.embed { background: color-mix(in srgb, var(--cz-accent) 60%, transparent); }
	.vb-seg.reserved { background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--cz-muted) 45%, transparent) 0 4px, transparent 4px 8px); border-radius: 0 5px 5px 0; }
	.cb-fig .vb-total { margin: 0; display: flex; flex-direction: column; gap: 0.15rem; color: var(--cz-bad); }
	.cb-fig .vb-total.fits { color: var(--cz-ok); }
	.vb-total b { font: 800 0.86rem/1 var(--font-space-grotesk); }
	.vb-total span { font-size: 0.72rem; font-weight: 600; }
	.vb-keys { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin-top: 0.3rem; font-size: 0.72rem; color: var(--cz-muted); }
	.vb-keys span { display: inline-flex; align-items: center; gap: 0.4rem; }
	.vb-key { display: inline-block; width: 16px; height: 10px; border-radius: 3px; }
	.vb-key.base { background: color-mix(in srgb, var(--cz-accent-2) 55%, transparent); }
	.vb-key.first { background: color-mix(in srgb, var(--cz-accent-2) 28%, transparent); }
	.vb-key.embed { background: color-mix(in srgb, var(--cz-accent) 60%, transparent); }
	.vb-key.reserved { background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--cz-muted) 45%, transparent) 0 3px, transparent 3px 6px); border: 1px solid var(--cz-line); }
</style>

<script>
	import { createTimeline, svg, type Timeline } from 'animejs';
	import { mount } from '../chzzk/cz-runtime';

	mount('[data-cb-vram]', (root) => {
		const grid = [...root.querySelectorAll<HTMLElement | SVGElement>('[data-grid]')];
		const card = root.querySelector<SVGGElement>('[data-card]')!;
		const pts = [...root.querySelectorAll<SVGElement>('[data-pt]')];
		const reads = [...root.querySelectorAll<SVGGElement>('[data-read]')];
		const drawn = svg.createDrawable(root.querySelectorAll('[data-draw]'));
		const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
		const segs = (r: HTMLElement) => [...r.querySelectorAll<HTMLElement>('.vb-seg')];
		const late = (r: HTMLElement) => r.querySelector<HTMLElement>('[data-late]')!;
		const fades = () => [...grid, card, ...pts, ...reads];
		let tl: Timeline | null = null;
		const arm = () => {
			tl?.pause();
			fades().forEach((e) => { e.style.opacity = '0'; });
			drawn.forEach((d) => d.setAttribute('draw', '0 0'));
			rows.forEach((r) => { segs(r).forEach((s) => { s.style.width = '0%'; }); late(r).style.opacity = '0'; });
		};
		const finish = () => {
			tl?.pause();
			fades().forEach((e) => { e.style.opacity = '1'; });
			drawn.forEach((d) => d.setAttribute('draw', '0 1'));
			rows.forEach((r) => { segs(r).forEach((s) => { s.style.width = `${s.dataset.w}%`; }); late(r).style.opacity = '1'; });
		};
		const play = () => {
			arm();
			const T = createTimeline({ autoplay: false, defaults: { ease: 'outCubic' } });
			T.add(grid, { opacity: [0, 1], duration: 400 }, 0);
			T.add(card, { opacity: [0, 1], duration: 400 }, 300);
			T.add(drawn, { draw: ['0 0', '0 1'], duration: 1300, ease: 'inOutSine' }, 500);
			T.add(pts, { opacity: [0, 1], duration: 300 }, 1500);
			T.add(reads, { opacity: [0, 1], duration: 350 }, 1900);
			// Each setting stacks up in order: 26B, first inference, embedding server, reserved.
			rows.forEach((r, i) => {
				let at = 2500 + i * 1900;
				segs(r).forEach((s, j) => {
					const d = j === 0 ? 700 : 380;
					T.add(s, { width: ['0%', `${s.dataset.w}%`], duration: d }, at);
					at += d + 80;
				});
				T.add(late(r), { opacity: [0, 1], duration: 300 }, at);
			});
			tl = T;
			T.play();
		};
		return { arm, play, finish };
	});
</script>
