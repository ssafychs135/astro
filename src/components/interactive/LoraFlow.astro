---
// LoRA explainer: one weight matrix, zoomed in. Three panels share the runtime in anim-runtime.ts.
//   train  x splits into two paths at once; W (frozen) vs A (1536 -> 32) then B (32 -> 2048); sum.
//   init   same graph with B = 0, so the lower path contributes 0 and h = Wx.
//   merge  (alpha/r)BA folds into W, leaving a single path; contrasted with sequential adapters.
// Dimensions are the trained model's attention q_proj (2048 x 1536, hidden size 1536), rank 32.
const modes = [
	{ key: 'train', label: '두 경로로 계산' },
	{ key: 'init', label: '학습 시작 시점' },
	{ key: 'merge', label: '학습 후 병합' },
];
const PHASES = '0,500,1200,1900,2600,3300,4000';
---

<div class="ts-ix not-prose lf" data-anim-group>
	<div class="ax-head">
		<div>
			<div class="ts-eyebrow">⚙ 애니메이션 · LoRA</div>
			<h4 class="ts-h">같은 입력이 두 경로로 동시에 들어간다</h4>
		</div>
		<button class="ax-play" data-anim-play type="button">▶ 다시 재생</button>
	</div>

	<div class="ts-tabs" role="tablist">
		{modes.map((m, i) => (
			<button class:list={[{ on: i === 0 }]} data-anim-tab={m.key} role="tab" aria-selected={i === 0 ? 'true' : 'false'} type="button">
				{m.label}
			</button>
		))}
	</div>

	<div class="ts-result">
		{['train', 'init'].map((mode, i) => (
			<div class:list={['ax-panel', 'lf-panel', `lf-${mode}`, { show: i === 0 }]} data-anim data-key={mode} data-phases={PHASES}>
				<svg class="ax-figure" viewBox="0 0 360 410" role="img"
					aria-label={mode === 'train'
						? 'LoRA 계산 흐름: 입력 x가 고정된 원본 가중치 W와, A와 B로 이루어진 우회로에 동시에 들어가고 두 결과를 더한다.'
						: 'B가 0인 학습 시작 시점: 우회로의 결과가 0이므로 출력은 Wx와 같다.'}>
					<!-- input -->
					<g class="lf-node lf-in">
						<rect x="105" y="8" width="150" height="46" rx="10" />
						<text x="180" y="28" class="lf-t-strong">입력 x</text>
						<text x="180" y="45" class="lf-t-dim">1536차원</text>
					</g>

					<!-- split: both branches draw at the same time -->
					<path class="lf-wire lf-w-in-l" d="M180 54 V78 H95 V104" pathLength="1" />
					<path class="lf-wire lf-w-in-r" d="M180 54 V78 H265 V98" pathLength="1" />
					<text x="188" y="71" class="lf-t-tag lf-anchor-start lf-split-tag">동시에</text>

					<!-- left path: frozen W -->
					<g class="lf-node lf-wbox">
						<rect x="30" y="104" width="130" height="150" rx="10" />
						<text x="95" y="160" class="lf-t-big">W</text>
						<text x="95" y="184" class="lf-t-dim">2048 × 1536</text>
						<text x="95" y="210" class="lf-t-lock">고정</text>
						<text x="95" y="228" class="lf-t-dim">학습하지 않음</text>
					</g>

					<!-- right path: A narrows, neck, B widens -->
					<g class="lf-node lf-a">
						<path d="M200 98 H330 L277 158 H253 Z" />
						<text x="265" y="118" class="lf-t-strong">A</text>
						<text x="265" y="136" class="lf-t-small">1536 → 32</text>
					</g>
					<g class="lf-node lf-neck">
						<rect x="253" y="158" width="24" height="36" />
						<text x="245" y="180" class="lf-t-tag lf-anchor-end">32차원</text>
						<text x="283" y="174" class="lf-t-note lf-anchor-start">활성화</text>
						<text x="283" y="187" class="lf-t-note lf-anchor-start">함수 없음</text>
					</g>
					<g class="lf-node lf-b">
						<path d="M253 194 H277 L330 254 H200 Z" />
						{mode === 'train' ? (
							<>
								<text x="265" y="226" class="lf-t-strong">B</text>
								<text x="265" y="245" class="lf-t-small">32 → 2048</text>
							</>
						) : (
							<>
								<text x="265" y="226" class="lf-t-strong">B = 0</text>
								<text x="265" y="245" class="lf-t-small">0으로 초기화</text>
							</>
						)}
					</g>

					<!-- outputs of both paths meet at + -->
					<path class="lf-wire lf-w-out-l" d="M95 254 V300 H166" pathLength="1" />
					<path class:list={['lf-wire', 'lf-w-out-r', { 'lf-zero': mode === 'init' }]} d="M265 254 V300 H194" pathLength="1" />
					<text x="282" y="280" class="lf-t-tag lf-anchor-start lf-scale">
						{mode === 'train' ? '× α/r' : '결과 0'}
					</text>
					<text x="85" y="280" class="lf-t-tag lf-anchor-end lf-wx">Wx</text>

					<g class="lf-node lf-plus">
						<circle cx="180" cy="300" r="14" />
						<text x="180" y="305" class="lf-t-plus">+</text>
					</g>
					<path class="lf-wire lf-w-final" d="M180 314 V338" pathLength="1" />
					<path class="lf-head lf-head-final" d="M173.4 328.1 L186.6 328.1 L180 341.3 Z" />

					<g class="lf-node lf-out">
						<rect x="40" y="344" width="280" height="58" rx="10" />
						{mode === 'train' ? (
							<text x="180" y="368" class="lf-t-strong">출력 h = Wx + (α/r)·BAx</text>
						) : (
							<text x="180" y="368" class="lf-t-strong">출력 h = Wx + 0 = Wx</text>
						)}
						<text x="180" y="389" class="lf-t-dim">
							{mode === 'train' ? '2048차원' : '원본 모델과 같은 출력'}
						</text>
					</g>
				</svg>

				{mode === 'train' ? (
					<ol class="ax-steps">
						<li data-at="2">입력 x(1536차원)가 갈라져서 두 경로로 동시에 들어간다.</li>
						<li data-at="3">왼쪽 경로에서는 고정된 원본 가중치 W를 통과하고, 오른쪽 경로에서는 A가 1536차원을 32차원으로 줄인다.</li>
						<li data-at="5">B가 32차원을 2048차원으로 펼친다. A와 B 사이에는 활성화 함수가 없다.</li>
						<li data-at="7">오른쪽 경로의 결과에 α/r을 곱한 뒤 두 결과를 더해서 출력 h를 만든다.</li>
					</ol>
				) : (
					<ol class="ax-steps">
						<li data-at="5">B를 0으로 초기화하므로 오른쪽 경로를 거친 결과는 0이다.</li>
						<li data-at="7">두 결과를 더하면 Wx만 남으므로, 학습을 시작하는 순간의 출력은 원본 모델과 같다.</li>
						<li data-at="7">학습이 진행되면서 B가 0에서 벗어나고, 그때부터 오른쪽 경로의 결과가 출력에 더해진다.</li>
					</ol>
				)}
			</div>
		))}

		<div class="ax-panel lf-panel lf-merge" data-anim data-key="merge" data-phases="0,700,1600,2500">
			<svg class="ax-figure" viewBox="0 0 360 300" role="img" aria-label="병합: (α/r)·BA를 W에 더해서 행렬 W′ 하나로 합치고, 입력은 경로 하나만 지난다.">
				<g class="lf-node lf-in">
					<rect x="105" y="8" width="150" height="46" rx="10" />
					<text x="180" y="28" class="lf-t-strong">입력 x</text>
					<text x="180" y="45" class="lf-t-dim">1536차원</text>
				</g>
				<path class="lf-wire lf-m-stem" d="M180 54 V92" pathLength="1" />

				<g class="lf-m-w">
					<g class="lf-node lf-wbox">
						<rect x="40" y="96" width="130" height="104" rx="10" />
						<text x="105" y="136" class="lf-t-big lf-m-before">W</text>
						<text x="105" y="160" class="lf-t-dim lf-m-before">2048 × 1536</text>
						<text x="105" y="136" class="lf-t-fit lf-m-after">W′ = W + (α/r)·BA</text>
						<text x="105" y="160" class="lf-t-dim lf-m-after">2048 × 1536</text>
						<text x="105" y="182" class="lf-t-dim lf-m-after">행렬 하나</text>
					</g>
				</g>
				<text x="180" y="154" class="lf-t-plus lf-m-plus">+</text>
				<g class="lf-m-ba">
					<g class="lf-node lf-b">
						<rect x="190" y="96" width="130" height="104" rx="10" />
						<text x="255" y="136" class="lf-t-strong">(α/r)·BA</text>
						<text x="255" y="160" class="lf-t-dim">2048 × 1536</text>
						<text x="255" y="182" class="lf-t-dim">B와 A의 곱</text>
					</g>
				</g>

				<path class="lf-wire lf-m-out" d="M180 200 V234" pathLength="1" />
				<path class="lf-head lf-head-merge" d="M173.4 224.1 L186.6 224.1 L180 237.3 Z" />
				<g class="lf-node lf-out">
					<rect x="70" y="240" width="220" height="52" rx="10" />
					<text x="180" y="262" class="lf-t-strong">출력 h = W′x</text>
					<text x="180" y="281" class="lf-t-dim">경로 하나</text>
				</g>
			</svg>

			<ol class="ax-steps">
				<li data-at="1">학습이 끝나면 B와 A를 곱한 BA도 W와 같은 2048×1536 행렬이 된다.</li>
				<li data-at="2">A와 B 사이에 활성화 함수가 없으므로 (α/r)·BA를 W에 그대로 더할 수 있다.</li>
				<li data-at="3">더한 결과 W′는 원본과 크기가 같은 행렬 하나이며, 입력은 경로 하나만 지난다.</li>
				<li data-at="4">그래서 병합한 모델의 추론 비용은 원본 모델과 같다.</li>
			</ol>

			<div class="lf-compare">
				<div class="lf-card">
					<div class="lf-card-h">adapter tuning (2019)</div>
					<div class="lf-card-flow">x → W → 어댑터 → h</div>
					<p>층 사이에 끼워 넣은 모듈을 입력이 반드시 통과한다. 그래서 배포한 뒤에도 추론 지연이 남는다.</p>
				</div>
				<div class="lf-card lf-card-lora">
					<div class="lf-card-h">LoRA</div>
					<div class="lf-card-flow">x → W′ → h</div>
					<p>학습할 때에만 두 경로로 계산한다. 병합하면 원본과 구조가 같아지므로 추론 비용이 늘지 않는다.</p>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.lf svg text {
		text-anchor: middle;
		fill: var(--text-base);
		font-family: var(--font-space-grotesk), system-ui, sans-serif;
	}
	/* Must out-rank `.lf svg text` (Astro scopes every compound selector), or labels fall back to middle. */
	.lf svg text.lf-anchor-end { text-anchor: end; }
	.lf svg text.lf-anchor-start { text-anchor: start; }
	.lf .lf-t-strong { font-size: 14px; font-weight: 700; }
	.lf .lf-t-big { font-size: 26px; font-weight: 800; }
	.lf .lf-t-fit { font-size: 12px; font-weight: 700; }
	.lf .lf-t-dim { font-size: 11.5px; fill: var(--text-muted); }
	.lf .lf-t-small { font-size: 11px; font-weight: 600; }
	.lf .lf-t-tag { font-size: 11.5px; font-weight: 700; fill: var(--color-secondary); }
	.lf .lf-t-note { font-size: 9.5px; fill: var(--text-muted); }
	.lf .lf-t-lock { font-size: 12px; font-weight: 700; fill: var(--text-muted); }
	.lf .lf-t-plus { font-size: 20px; font-weight: 800; fill: var(--color-primary); }

	.lf .lf-node rect,
	.lf .lf-node path,
	.lf .lf-node circle {
		fill: var(--color-surface-highest);
		stroke: var(--glass-border);
		stroke-width: 1.5;
		transition: fill 0.4s, stroke 0.4s;
	}
	.lf .lf-wbox rect { fill: color-mix(in srgb, var(--text-muted) 12%, var(--color-surface-highest)); }
	.lf .lf-a path,
	.lf .lf-b path,
	.lf .lf-b rect,
	.lf .lf-neck rect {
		fill: color-mix(in srgb, var(--color-secondary) 16%, var(--color-surface-highest));
		stroke: color-mix(in srgb, var(--color-secondary) 55%, transparent);
	}
	.lf .lf-in rect,
	.lf .lf-out rect,
	.lf .lf-plus circle {
		stroke: color-mix(in srgb, var(--color-primary) 55%, transparent);
	}
	/* Arrowheads are separate shapes (an SVG marker ignores stroke-dashoffset and would sit at the end
	   before the line is drawn). They fade in once the 0.45s draw finishes and hide instantly on rewind. */
	.lf .lf-head { fill: var(--color-primary); stroke: none; }
	.lf .armed .lf-head { opacity: 0; transition: none; }
	.lf .armed.p7 .lf-head-final,
	.lf .lf-merge.armed.p3 .lf-head-merge { opacity: 1; transition: opacity 0.15s ease-out 0.45s; }

	.lf .lf-wire {
		fill: none;
		stroke: var(--color-primary);
		stroke-width: 2.2;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		transition: stroke-dashoffset 0.45s ease-out;
	}
	.lf .lf-wire.lf-zero { stroke: var(--text-muted); stroke-dasharray: 0.02 0.02; }

	/* Pre-animation state (only once armed by the runtime). */
	.lf .armed .lf-node,
	.lf .armed .lf-split-tag,
	.lf .armed .lf-scale,
	.lf .armed .lf-wx { opacity: 0; transition: opacity 0.45s; }
	.lf .armed .lf-wire { stroke-dashoffset: 1; }
	.lf .armed .lf-wire.lf-zero { stroke-dashoffset: 0; opacity: 0; transition: opacity 0.45s; }

	.lf .armed.p1 .lf-in { opacity: 1; }
	.lf .armed.p2 .lf-w-in-l,
	.lf .armed.p2 .lf-w-in-r { stroke-dashoffset: 0; }
	.lf .armed.p2 .lf-split-tag { opacity: 1; }
	.lf .armed.p3 .lf-wbox,
	.lf .armed.p3 .lf-a { opacity: 1; }
	.lf .armed.p4 .lf-neck { opacity: 1; }
	.lf .armed.p5 .lf-b { opacity: 1; }
	.lf .armed.p6 .lf-w-out-l,
	.lf .armed.p6 .lf-w-out-r { stroke-dashoffset: 0; }
	.lf .armed.p6 .lf-w-out-r.lf-zero { opacity: 1; }
	.lf .armed.p6 .lf-scale,
	.lf .armed.p6 .lf-wx { opacity: 1; }
	.lf .armed.p7 .lf-plus,
	.lf .armed.p7 .lf-out { opacity: 1; }
	.lf .armed.p7 .lf-w-final { stroke-dashoffset: 0; }

	/* Merge panel */
	.lf .lf-m-w,
	.lf .lf-m-ba,
	.lf .lf-m-plus,
	.lf .lf-m-before,
	.lf .lf-m-after {
		transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s;
	}
	/* Final (merged) state is the default; the runtime rewinds it while armed. */
	.lf .lf-m-w { transform: translateX(75px); }
	.lf .lf-m-ba { transform: translateX(-75px); opacity: 0; }
	.lf .lf-m-plus,
	.lf .lf-m-before { opacity: 0; }
	.lf .armed .lf-m-w { transform: none; }
	.lf .armed .lf-m-ba { transform: none; opacity: 1; }
	.lf .armed .lf-m-plus,
	.lf .armed .lf-m-before { opacity: 1; }
	.lf .armed .lf-m-after { opacity: 0; }
	.lf .armed.p2 .lf-m-w { transform: translateX(75px); }
	.lf .armed.p2 .lf-m-ba { transform: translateX(-75px); opacity: 0; }
	.lf .armed.p2 .lf-m-plus { opacity: 0; }
	.lf .armed.p3 .lf-m-before { opacity: 0; }
	.lf .armed.p3 .lf-m-after { opacity: 1; }
	.lf .lf-merge .lf-m-stem,
	.lf .lf-merge .lf-m-out { transition: stroke-dashoffset 0.45s ease-out; }
	.lf .lf-merge.armed .lf-node { opacity: 1; }
	.lf .lf-merge.armed .lf-out { opacity: 0; }
	.lf .lf-merge.armed.p3 .lf-m-stem,
	.lf .lf-merge.armed.p3 .lf-m-out { stroke-dashoffset: 0; }
	.lf .lf-merge.armed.p3 .lf-out { opacity: 1; }
	.lf .lf-merge .lf-card { transition: opacity 0.4s, border-color 0.4s; }
	.lf .lf-merge.armed .lf-card { opacity: 0.4; }
	.lf .lf-merge.armed.p4 .lf-card { opacity: 1; }

	.lf-compare {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 0.75rem;
		margin-top: 1rem;
	}
	.lf-card {
		border: 1px solid var(--glass-border);
		border-radius: 10px;
		padding: 0.8rem 0.9rem;
		background: var(--color-surface-high);
	}
	.lf-card-lora { border-color: color-mix(in srgb, var(--color-primary) 45%, transparent); }
	.lf-card-h { font: 700 0.8rem/1.3 var(--font-space-grotesk); color: var(--text-base); }
	.lf-card-flow {
		margin: 0.35rem 0 0.45rem;
		font: 600 0.78rem/1.3 var(--font-space-grotesk);
		color: var(--color-secondary);
	}
	.lf-card-lora .lf-card-flow { color: var(--color-primary); }
	.lf-card p { margin: 0; font-size: 0.78rem; line-height: 1.6; color: var(--text-muted); }
</style>

<script>
	import './anim-runtime.ts';
</script>
