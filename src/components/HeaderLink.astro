---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Compare the first path segment after the base path ("/astro/blog/x/" -> "blog").
// Header is persisted across view transitions, so Header.astro re-runs the same check on every navigation.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = (path: string) => path.replace(base, '').split('/').filter(Boolean)[0] ?? '';
const target = section(String(href ?? ''));
const isActive = target !== '' && section(Astro.url.pathname) === target;
---

<a href={href} data-nav-section={target} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		position: relative;
		transition: color 0.3s ease;
	}
	/* font-weight 변경 대신 색상과 언더라인 효과로 시인성 확보 */
	a.active {
		color: var(--primary) !important;
		opacity: 1 !important;
	}
	a.active::after {
		content: "";
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 100%;
		height: 1px;
		background-color: var(--primary);
	}
</style>
