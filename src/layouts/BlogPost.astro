---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface SeriesLink {
	href: string;
	part: number;
	subtitle: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	// Set by the route when the post belongs to a series (see utils/series.ts).
	series?: { name: string; part: number; first: number; last: number; prev?: SeriesLink; next?: SeriesLink };
};

const { title, description, pubDate, updatedDate, heroImage, tags, category, series } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Some posts still carry the starter template's placeholder hero; don't send it out as the share image.
const shareImage = heroImage && !heroImage.src.includes('blog-placeholder') ? heroImage : undefined;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={shareImage} type="article" publishedTime={pubDate} />
	</head>

	<body class="bg-bg-base text-text-base antialiased">
		<Header />
		<main class="max-w-5xl mx-auto px-6 py-24" transition:animate="fade">
			<article>
				<header class="mb-16">
					<div class="tech-label mb-8">
						<span class="text-primary">> Research_Note</span>
						{series ? <span class="opacity-50">Series // {series.name}</span> : category && <span class="opacity-50">{category}</span>}
					</div>
					<h1 class="text-4xl md:text-6xl font-black tracking-tighter pb-10 leading-[1.15]">
						{title}
					</h1>

					<p class="text-xl md:text-2xl text-text-muted leading-relaxed max-w-3xl mb-12">
						{description}
					</p>

					<div class="telemetry-bar">
						<div class="telemetry-item">
							<span class="tech-label opacity-40 !text-[10px]">Timestamp</span>
							<span class="font-bold"><FormattedDate date={pubDate} /></span>
						</div>
						{series && (
							<div class="telemetry-item">
								<span class="tech-label opacity-40 !text-[10px]">Series</span>
								<span class="font-bold">{series.part}편 <span class="text-text-muted font-normal">/ {series.first}~{series.last}편</span></span>
							</div>
						)}
						{updatedDate && (
							<div class="telemetry-item">
								<span class="tech-label opacity-40 !text-[10px]">Last_Update</span>
								<span class="font-bold"><FormattedDate date={updatedDate} /></span>
							</div>
						)}
						{tags && tags.length > 0 && (
							<div class="telemetry-item">
								<span class="tech-label opacity-40 !text-[10px]">Tags</span>
								<div class="flex flex-wrap gap-2">
									{tags.map((t) => <span class="tag-obsidian !text-xs">{t}</span>)}
								</div>
							</div>
						)}
					</div>
				</header>

				{heroImage && (
					<div class="blueprint-frame">
						<div class="rounded-sm overflow-hidden border border-white/5">
							<Image width={1200} height={600} src={heroImage} alt="" class="w-full h-auto grayscale hover:grayscale-0 transition-all duration-1000" />
						</div>
					</div>
				)}

				<div class="prose-obsidian max-w-none">
					<slot />
				</div>
			</article>

			<nav class="mt-24 pt-10 border-t border-surface-highest/30" aria-label="글 이동">
				{series && (series.prev || series.next) && (
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
						{series.prev ? (
							<a href={series.prev.href} class="block p-6 bg-surface-low border border-surface-highest/30 rounded-sm no-underline hover:border-primary transition-colors group">
								<div class="tech-font text-[11px] font-bold tracking-widest text-text-muted mb-2">← 이전 편 · {series.prev.part}편</div>
								<div class="font-bold group-hover:text-primary transition-colors">{series.prev.subtitle}</div>
							</a>
						) : <div class="hidden md:block"></div>}
						{series.next && (
							<a href={series.next.href} class="block p-6 bg-surface-low border border-surface-highest/30 rounded-sm no-underline hover:border-primary transition-colors group md:text-right">
								<div class="tech-font text-[11px] font-bold tracking-widest text-text-muted mb-2">다음 편 · {series.next.part}편 →</div>
								<div class="font-bold group-hover:text-primary transition-colors">{series.next.subtitle}</div>
							</a>
						)}
					</div>
				)}
				<a href={`${base}/blog/`} class="tech-font text-sm font-black opacity-60 hover:opacity-100 hover:text-primary transition-all no-underline">← 전체 글 목록</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>
